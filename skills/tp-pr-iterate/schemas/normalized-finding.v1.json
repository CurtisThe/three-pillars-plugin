{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tp-pr-iterate/normalized-finding.v1",
  "title": "Normalized dual-source review finding (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "file", "line_range", "summary", "verdict"],
  "properties": {
    "source": {
      "type": "string",
      "enum": ["copilot", "code-review"]
    },
    "finding_id": {
      "type": ["string", "integer"]
    },
    "thread_id": {
      "type": ["string", "null"]
    },
    "comment_id": {
      "type": ["string", "integer", "null"]
    },
    "reviewer": {
      "type": "string"
    },
    "file": {
      "type": "string"
    },
    "line_range": {
      "type": "array",
      "items": {"type": "integer"},
      "minItems": 2,
      "maxItems": 2
    },
    "summary": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": ["structural", "minor", "unclear"]
    },
    "confidence": {
      "type": "string",
      "enum": ["High", "Medium", "Low"]
    },
    "merged_from": {
      "type": ["array", "null"],
      "items": {"type": ["string", "integer"]}
    },
    "class": {
      "type": "string",
      "enum": ["P", "X", "T", "C"]
    },
    "blocking": {
      "type": "boolean"
    },
    "origin": {
      "type": "string",
      "enum": ["original", "regression", "unclassified"]
    },
    "origin_source": {
      "type": "string",
      "enum": ["blame", "reviewer"]
    },
    "fragility_class": {
      "type": "string",
      "enum": ["open-ended", "change-detector", "blocklist", "none", "unclassified"]
    },
    "reproducer": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "enum": ["test", "command"]},
        "source": {"type": "string"},
        "argv": {"type": "array", "items": {"type": "string"}},
        "expect": {"type": "object"}
      }
    },
    "alt_reproducers": {
      "type": "array",
      "items": {"$ref": "#/properties/reproducer"}
    },
    "downgrade": {
      "type": "object",
      "required": ["reason"],
      "properties": {
        "reason": {"type": "string"},
        "output": {"type": "string"}
      }
    },
    "schema_note": {
      "type": "string"
    },
    "reproducer_origin": {
      "type": "string",
      "enum": ["scaffold-adopted"]
    },
    "reproduction": {
      "type": "string",
      "enum": ["reproduced", "refuted", "inconclusive"]
    },
    "escape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition"],
      "properties": {
        "disposition": {"type": "string", "enum": ["kept", "downgraded", "opus-added"]},
        "reason": {"type": "string"}
      }
    },
    "severity_note": {
      "type": "string"
    },
    "dispositioned": {
      "type": "boolean"
    },
    "disposition_note": {
      "type": "string"
    }
  }
}
